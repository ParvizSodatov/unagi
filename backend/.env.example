# Порт, на котором поднимается API
PORT=4001

# Секрет для подписи JWT-токенов. На проде обязательно поменять на длинную случайную строку.
JWT_SECRET=change-me-to-a-long-random-string

# Первый админ, создаётся при инициализации базы, если её ещё нет
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Откуда разрешены запросы (фронтенд). Через запятую можно несколько.
CORS_ORIGIN=http://localhost:5173

# Telegram-оповещения о новых заказах (кухне/менеджеру).
# Оставьте пустыми — оповещения просто отключатся.
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather.
# TELEGRAM_CHAT_ID — id чата/группы, куда слать (узнать через @userinfobot или getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
